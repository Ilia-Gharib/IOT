# ==============================================================================
# Smart Building Voice Gateway - Environment Configuration
# ==============================================================================
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# --- LLM & STT ---
WHISPER_MODEL_SIZE=base
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_ENABLED=false

# --- Home Assistant Docker Instances & Long-Lived Access Tokens ---
HA_FLOOR1_URL=http://localhost:8124
HA_TOKEN_FLOOR1=YOUR_FLOOR_1_LONG_LIVED_ACCESS_TOKEN

HA_FLOOR2_URL=http://localhost:8125
HA_TOKEN_FLOOR2=YOUR_FLOOR_2_LONG_LIVED_ACCESS_TOKEN

# --- Hybrid TTS (Edge-TTS + Local Piper Fallback) ---
TTS_VOICE=fa-IR-DilaraNeural
PIPER_MODEL_NAME=fa_IR-amir-medium
PIPER_MODELS_DIR=./storage/models
TTS_CACHE_DIR=./storage/cache

# --- Security & JWT ---
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=43200
USERS_FILE=./storage/users.json

# --- SMTP for Forgot Password Email OTP (falls back to terminal print if empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@building.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
